# ===========================================
# Pentester-Claude Security Gitignore
# ===========================================

# Credentials & Secrets
.credentials.json
*.credentials*
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Session Data (contains target info, hashes, recon data)
sessions/

# Command History & Logs
*.jsonl
history.jsonl
shell-snapshots/
# ...except checked-in test fixtures, which need to actually be committed
# for tests/ to be runnable after a fresh clone - the blanket *.jsonl rule
# above is meant for runtime session data (attempts.jsonl/trace logs under
# a real $SESSION_DIR), not test fixtures that happen to share the name.
!tests/**/fixtures/**/*.jsonl

# Generated by tests/calibration's real attempt-aggregator.sh run against
# fixtures/ as its --session-base - not a fixture itself, regenerated
# every test run.
tests/calibration/fixtures/.calibrated-rates.json

# Analytics & Telemetry
statsig/

# Internal State & Cache
todos/
cache/
*.cache
*.sqlite

# Project-specific
projects/

# Common sensitive patterns
*_password*
*_secret*
*.hash
**/loot/
**/creds/
**/dumps/

# Python artifacts
__pycache__/
*.pyc

# OS artifacts
.DS_Store
Thumbs.db

# Editor/IDE
*.swp
*.swo
*~
.idea/
.vscode/settings.json
